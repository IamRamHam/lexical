# Only the public project URL and publishable key go into the browser.
LEXICAL_SUPABASE_URL=
LEXICAL_SUPABASE_PUBLISHABLE_KEY=

# Published Phonetic URL (optional). A local build can use the sibling Phonetic copy.
LEXICAL_PHONETIC_URL=

# Optional paths, relative to the Lexical project or absolute.
LEXICAL_WORDS_ORIGINAL=
LEXICAL_PHONETIC_DIR=
