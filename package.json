{
  "name": "lexical",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "data:release": "node scripts/prepare-release-data.mjs",
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "node --env-file-if-exists=.env scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "esbuild": "0.27.3"
  }
}
